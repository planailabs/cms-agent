# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://cms:cms@localhost:5432/cms_agent
# Unix socket: ALWAYS include the user — Prisma defaults a missing user to
# "postgres" (not the OS user), which peer auth rejects with P1010:
#DATABASE_URL=postgresql://youruser@localhost/cms_agent?host=/run/postgresql

# ─── Auth (better-auth + generic OIDC) ───────────────────────────────────────
# DEVELOPMENT ONLY: skip sign-in entirely; you are admin@localhost and
# user@localhost / user2@localhost are seeded for impersonation
# (POST /api/dev/impersonate). The Procfile enables this. NEVER in production.
#SKIP_AUTH=true
BETTER_AUTH_SECRET=change-me-32-chars-minimum-secret
BETTER_AUTH_URL=http://localhost:4321
OIDC_ISSUER=https://idp.example.com
OIDC_CLIENT_ID=cms-agent
OIDC_CLIENT_SECRET=change-me
# Optional authorization allowlist (comma-separated emails and/or a domain)
#ALLOWED_EMAILS=alice@example.com,bob@example.com
#ALLOWED_EMAIL_DOMAIN=example.com

# ─── Model endpoint (any OpenAI-compatible API) ──────────────────────────────
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1
# Reasoning effort sent with every agent turn: low | medium | high | none
# ('none' omits the parameter entirely, for backends that reject it).
OPENAI_REASONING_EFFORT=low
#OPENAI_IMAGE_MODEL=gpt-image-1
# Default user communication mode: non-technical | technical
#DEFAULT_COMMUNICATION_MODE=non-technical
# Vision model for turns with image attachments (falls back to OPENAI_MODEL).
#OPENAI_VISION_MODEL=gpt-4.1
# Smaller model the testbench judge grades results with (falls back to OPENAI_MODEL).
JUDGE_MODEL=gpt-5.6-luna
# Small model that picks which skills and MCP groups a turn is hinted with. Required.
SKILL_ROUTER_MODEL=gpt-5.6-luna
#OPENAI_MAX_TOKENS=4096

# ─── Domains / networking ────────────────────────────────────────────────────
# CMS UI lives at BASE_DOMAIN; previews at <branch>.BASE_DOMAIN (via proxy/)
BASE_DOMAIN=localhost
# Carry the incoming development port into branch preview URLs.
# DEV_PORT_CARRY=1
HOST=127.0.0.1
PORT=4321
# Set only outside `nix develop`; Nix supplies the pinned Firecrawl napi addon.
# FIRECRAWL_NATIVE_PATH=/absolute/path/to/firecrawl-rs.node
# Required outside `nix develop`; Nix supplies the embedded Pingora addon.
# PROXY_NATIVE_PATH=/absolute/path/to/cms-agent-proxy.node

# ─── Managed target repo (the site this CMS edits) ───────────────────────────
# Must be a git repository of its own. For development, create one from an
# example:   scripts/setup-dev-site.sh blog-site
REPO_PATH=./local/dev-site
# Site backend: auto-detected (astro.config.* or an astro dependency → astro,
# else static). Set explicitly to pin it.
#SITE_BACKEND=astro
# Dev/build command overrides; defaults come from the site backend
# (astro: npx --no astro dev|build; static: python http.server, no build).
#REPO_DEV_COMMAND=npx --no astro dev
#REPO_BUILD_COMMAND=npx --no astro build
# Extra content-collection → route mappings for the visual diff, JSON:
#ROUTE_MAPPINGS=[{"files":"src/content/blog/*.md","route":"/blog/:slug/"}]

# ─── Deployment flow ─────────────────────────────────────────────────────────
# One of: git-push | web-agency | github-ci | cloudflare-pages
DEPLOY_FLOW=git-push
#DEPLOY_GIT_REMOTE=origin                       # git-push, github-ci
#PUBLISH_COMMAND=./deploy.sh                    # web-agency (gets TARBALL_PATH, DIST_DIR, GIT_SHA)
#GITHUB_TOKEN=ghp_...                           # github-ci
#GITHUB_REPO=owner/repo                         # github-ci
#CLOUDFLARE_API_TOKEN=...                       # cloudflare-pages
#CLOUDFLARE_ACCOUNT_ID=...                      # cloudflare-pages
#CLOUDFLARE_PAGES_PROJECT=...                   # cloudflare-pages

# ─── Agent extras ────────────────────────────────────────────────────────────
# Context7 docs MCP (mcp.context7.com) attached to chats when a key is set.
# Get one at context7.com/dashboard.
#CONTEXT7_API_KEY=ctx7sk-...

# ─── Sandbox (every command run against the managed site) ────────────────────
# bwrap | none. 'none' is a DEVELOPMENT fallback (default on macOS, which has
# no bubblewrap): no jail, just a scrubbed environment and the node shell's
# PATH. Production refuses it.
#SANDBOX_MODE=bwrap
# Node major the site's commands see: 22 | 24 | 26.
#SANDBOX_NODE_MAJOR=26
# Network inside the jail — needed for `npm install`; 0 isolates it.
#SANDBOX_ALLOW_NETWORK=1
# Built sandbox dir (squashfs + manifest). Baked into the image; in dev/test
# scripts/launch-with-sandbox.sh sets it.
#SANDBOX_DIR=/absolute/path/to/sandbox

# ─── Embedded proxy (proxy/README.md) ────────────────────────────────────────
#PROXY_LISTEN=0.0.0.0:8080
# http | https — the scheme of the PUBLIC origin, when it differs from the
# listener (a TLS terminator in front).
#PUBLIC_SCHEME=https
# Require a signed-in session for preview subdomains (defaults off with
# SKIP_AUTH, on otherwise).
#PREVIEW_REQUIRE_AUTH=1
#CMS_UPSTREAM=127.0.0.1:4321

# ─── Runtime state (worktrees, previews, artifacts, uploads, routes file) ────
VAR_DIR=./var

# ─── Budgets (tokens per user per hour; 0 = unlimited) ───────────────────────
#INPUT_TOKEN_BUDGET_PER_HOUR=0
#OUTPUT_TOKEN_BUDGET_PER_HOUR=0

# ─── Preview manager ─────────────────────────────────────────────────────────
#PREVIEW_IDLE_TIMEOUT_MS=600000
#PREVIEW_MAX_INSTANCES=5

# ─── Metrics (Prometheus, at /metrics through the proxy) ─────────────────────
# On by default: the exposition is served by a listener on an EPHEMERAL
# loopback port, which the proxy routes /metrics to on the CMS host. Nothing
# has to be set for it to work in development.
#METRICS_ENABLED=true
# Bearer token scrapers must send (Authorization: Bearer …). REQUIRED in a
# production build (docker image and NixOS module alike) — there the endpoint
# is reachable wherever the CMS is, so the server refuses to boot without one.
# Any 16+ character secret.
#METRICS_TOKEN=

# ─── Notifications ("tell me when this chat is done") ────────────────────────
# Per channel: which registered provider, the sender identity, and that
# provider's credentials as a JSON object. A channel with no provider set is
# never offered in the UI, so leaving this whole section out simply means
# nobody can arm a notification.
# Providers: sms = twilio | vonage | logger, email = smtp | resend | logger.
# 'logger' delivers to the server log — a dry run that needs no vendor.
#NOTIFY_SMS_PROVIDER=twilio
#NOTIFY_SMS_FROM=+15005550006
#NOTIFY_SMS_CONFIG={"accountSid":"AC...","authToken":"..."}
# vonage: {"apiKey":"...","apiSecret":"..."} (NOTIFY_SMS_FROM may be a name)
#NOTIFY_EMAIL_PROVIDER=smtp
#NOTIFY_EMAIL_FROM=cms@example.com
#NOTIFY_EMAIL_CONFIG={"host":"smtp.example.com","port":587,"auth":{"user":"cms","pass":"..."}}
# resend: {"apiKey":"re_..."}

# ─── OpenTelemetry (traces/metrics from @opentelemetry/auto-instrumentations) ─
# NOT settable from this file. The SDK is registered by --import before any
# application code runs, and .env is read from inside the app (dotenv, at
# import time) — anything OTEL_* put here is already too late to be seen.
# They belong in the PROCESS environment: `.overmind.env` in development, the
# compose `environment:` block, or services.cms-agent.extraEnvironment.
#
# Unrelated to METRICS_* above: that exposition is scraped from the process,
# this one is pushed to a collector. Every launch path already starts node
# with the ESM hook + register flags, so only the exporter is opt-in:
#
#   OTEL_SDK_DISABLED=false            (ships true — see docs/setup.md)
#   OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
#   OTEL_SERVICE_NAME=cms-agent
#   OTEL_NODE_RESOURCE_DETECTORS=env,host,os,process,serviceinstance
