---
/**
 * CMS Workspace — live branch preview (left) + resizable chat sidebar
 * (right). All UI is client-rendered by the vanilla-TS app in
 * src/components/chat/main.ts (+ src/components/workspace/**).
 *
 * BASE_DOMAIN + scheme are inlined as data attributes on #app because
 * import.meta.env.PUBLIC_* is not configured for this deployment.
 */
export const prerender = false;

const user = Astro.locals.user!;
const baseDomain = process.env.BASE_DOMAIN ?? 'localhost';
const scheme =
  process.env.PUBLIC_SCHEME ?? (Astro.url.protocol === 'https:' ? 'https' : 'http');
---

<!doctype html>
<html lang={user.language} class="is-first-visit">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>CMS Agent</title>
  </head>
  <body>
    <div
      id="app"
      data-base-domain={baseDomain}
      data-scheme={scheme}
      data-user-name={user.name}
    >
    </div>
    <script>
      import '@/components/chat/main';
    </script>
  </body>
</html>
