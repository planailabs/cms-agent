---
import { t } from '@/lib/i18n';

// Deep-link carry-through from the middleware redirect. Same-origin absolute
// paths only — anything else (//host, https://…) falls back to /.
const nextRaw = Astro.url.searchParams.get('next') ?? '/';
const nextPath = /^\/(?!\/|\\)/.test(nextRaw) ? nextRaw : '/';

if (Astro.locals.user) return Astro.redirect(nextPath);

// Pre-auth page — no user language yet; negotiate from Accept-Language.
const lang = /(^|[,;\s])de\b/i.test(Astro.request.headers.get('accept-language') ?? '') ? 'de' : 'en';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t(lang, 'pages.signin.title')}</title>
    <style>
      body {
        font-family: system-ui, sans-serif;
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 100vh;
        margin: 0;
        background: #0b0d10;
        color: #e6e8ea;
      }
      .card {
        text-align: center;
        padding: 3rem;
        border: 1px solid #2a2f36;
        border-radius: 12px;
        background: #12151a;
      }
      button {
        margin-top: 1.5rem;
        padding: 0.75rem 2rem;
        font-size: 1rem;
        border-radius: 8px;
        border: none;
        background: #3b82f6;
        color: white;
        cursor: pointer;
      }
      button:hover { background: #2563eb; }
      .error { color: #f87171; margin-top: 1rem; min-height: 1.2em; }
    </style>
  </head>
  <body>
    <div class="card">
      <h1>{t(lang, 'pages.signin.heading')}</h1>
      <p>{t(lang, 'pages.signin.description')}</p>
      <button id="signin" data-next={nextPath}>{t(lang, 'pages.signin.button')}</button>
      <p
        class="error"
        id="error"
        data-msg-failed={t(lang, 'pages.signin.failed')}
        data-msg-network={t(lang, 'pages.signin.failedNetwork')}
      ></p>
    </div>
    <script>
      document.getElementById('signin')!.addEventListener('click', async () => {
        const errorEl = document.getElementById('error')!;
        errorEl.textContent = '';
        const button = document.getElementById('signin')!;
        try {
          const res = await fetch('/api/auth/sign-in/oauth2', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ providerId: 'oidc', callbackURL: button.dataset.next || '/' }),
          });
          const data = await res.json();
          if (data.url) {
            window.location.href = data.url;
          } else {
            errorEl.textContent = data.message ?? errorEl.dataset.msgFailed!;
          }
        } catch {
          errorEl.textContent = errorEl.dataset.msgNetwork!;
        }
      });
    </script>
  </body>
</html>
