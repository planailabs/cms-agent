---
/**
 * Boot page for preview hosts. The Pingora sidecar rewrites requests for
 * unknown/stopped <branch>.BASE_DOMAIN hosts here; we trigger the instance
 * start and auto-refresh until the sidecar picks up the new route.
 * Auth: middleware already required a session to reach this page.
 */
import { prisma } from '@/lib/db';
import { ensureInstance } from '@/lib/preview/manager';
import { PREVIEW_COOKIE_NAME, verifyPreviewCookie } from '@/lib/previewCookie';

// Auth: either a CMS session (direct hit) or the sidecar's HMAC preview
// cookie (requests proxied from <branch>.BASE_DOMAIN).
const previewCookie = Astro.cookies.get(PREVIEW_COOKIE_NAME)?.value;
const previewAuth = previewCookie ? verifyPreviewCookie(previewCookie) : null;
if (!Astro.locals.user && !previewAuth) {
  return Astro.redirect('/signin/');
}

const branch = Astro.params.branch ?? '';
const known = await prisma.branch.findUnique({ where: { name: branch } });
const isMain = branch === 'main';

if (!known && !isMain) {
  Astro.response.status = 404;
}

if (known || isMain) {
  // Fire and forget — the page refreshes until the route exists.
  void ensureInstance(branch).catch((err) =>
    console.error(`[preview] failed to start ${branch}:`, err),
  );
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    {(known || isMain) && <meta http-equiv="refresh" content="2" />}
    <title>Starting preview…</title>
    <style>
      body {
        font-family: system-ui, sans-serif;
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 100vh;
        margin: 0;
        background: #0b0d10;
        color: #e6e8ea;
      }
      .pulse {
        animation: pulse 1.2s ease-in-out infinite;
      }
      @keyframes pulse { 50% { opacity: 0.4; } }
    </style>
  </head>
  <body>
    {known || isMain ? (
      <p class="pulse">Starting preview for <strong>{branch}</strong> — this page reloads automatically…</p>
    ) : (
      <p>Unknown branch <strong>{branch}</strong>.</p>
    )}
  </body>
</html>
