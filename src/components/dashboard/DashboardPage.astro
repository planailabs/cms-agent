---
/**
 * Admin dashboard shell — ported from chat/'s DashboardPage.astro.
 *
 * Admin access is enforced server-side by src/pages/dashboard/[...tab].astro
 * (Astro.locals.user.role === 'admin'), so there is no client-side auth
 * check or loading gate. Tabs are URL-driven and lazily initialized by
 * tabs.ts. Impersonation, messages, pings and customer tokens from chat/
 * are not ported; memory is new.
 */
import '../chat/style.css';
import { t } from '@/lib/i18n';

// User language from the route (server truth) — drives dashboard i18n via
// uiLocale() reading <html lang>. Static shell strings render server-side
// with t(lang, …) here; client modules re-render dynamic parts with
// t(uiLocale(), …).
const { lang = 'en' } = Astro.props;
---

<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{t(lang, 'dashboard.shell.pageTitle')}</title>

    <!-- Theme script: resolve stored/system theme before first paint -->
    <script is:inline>
      (() => {
        const THEME_STORAGE_KEY = 'cmsagent-theme-mode';
        let stored = null;
        try {
          stored = sessionStorage.getItem(THEME_STORAGE_KEY);
        } catch {
          /* storage unavailable */
        }
        const prefersDark =
          window.matchMedia &&
          window.matchMedia('(prefers-color-scheme: dark)').matches;
        const theme =
          stored === 'dark' || stored === 'light'
            ? stored
            : prefersDark
              ? 'dark'
              : 'light';
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
  </head>
  <body>
    <div class="dash-root">
      <!-- Header -->
      <header class="dash-header">
        <div>
          <h1 class="dash-title">{t(lang, 'dashboard.shell.title')}</h1>
          <p class="dash-subtitle">{t(lang, 'dashboard.shell.subtitle')}</p>
        </div>
        <a href="/" class="dash-btn">{t(lang, 'dashboard.shell.backToApp')}</a>
      </header>

      <!-- Tab Navigation -->
      <nav class="dash-tabs">
        <button type="button" data-tab="overview" class="dash-tab">{t(lang, 'dashboard.tabs.overview')}</button>
        <button type="button" data-tab="tokens" class="dash-tab">{t(lang, 'dashboard.tabs.tokens')}</button>
        <button type="button" data-tab="users" class="dash-tab">{t(lang, 'dashboard.tabs.users')}</button>
        <button type="button" data-tab="prompts" class="dash-tab">{t(lang, 'dashboard.tabs.prompts')}</button>
        <button type="button" data-tab="memory" class="dash-tab">{t(lang, 'dashboard.tabs.memory')}</button>
        <button type="button" data-tab="uploads" class="dash-tab">{t(lang, 'dashboard.tabs.uploads')}</button>
        <button type="button" data-tab="system" class="dash-tab">{t(lang, 'dashboard.tabs.system')}</button>
      </nav>

      <!-- ═══════════════════════ TAB PANELS ═══════════════════════ -->

      <!-- Overview Tab -->
      <div id="tab-overview" class="tab-panel hidden">
        <div class="stats-grid dash-grid">
          <div class="dash-card dash-stat animate-pulse">
            <div class="dash-stat__label">{t(lang, 'dashboard.common.loading')}</div>
          </div>
        </div>
      </div>

      <!-- Tokens Tab -->
      <div id="tab-tokens" class="tab-panel hidden dash-stack">
        <div class="dash-row">
          <h2 class="dash-section-title">{t(lang, 'dashboard.tokens.title')}</h2>
          <label class="dash-field dash-field--inline">
            <span>{t(lang, 'dashboard.tokens.period')}</span>
            <select class="days-select dash-input">
              <option value="7">{t(lang, 'dashboard.tokens.days7')}</option>
              <option value="30" selected>{t(lang, 'dashboard.tokens.days30')}</option>
              <option value="90">{t(lang, 'dashboard.tokens.days90')}</option>
            </select>
          </label>
        </div>

        <div class="dash-card dash-chart-card">
          <h3 class="dash-card-title">{t(lang, 'dashboard.tokens.chartTitle')}</h3>
          <div class="usage-chart">
            <div class="dash-td-muted">{t(lang, 'dashboard.tokens.loadingChart')}</div>
          </div>
        </div>

        <div class="dash-table-wrap">
          <table class="dash-table">
            <thead>
              <tr>
                <th>{t(lang, 'dashboard.tokens.colUser')}</th>
                <th class="dash-num">{t(lang, 'dashboard.tokens.colInput')}</th>
                <th class="dash-num">{t(lang, 'dashboard.tokens.colOutput')}</th>
                <th class="dash-num">{t(lang, 'dashboard.tokens.colTotal')}</th>
              </tr>
            </thead>
            <tbody class="usage-table-body">
              <tr class="animate-pulse">
                <td class="dash-td-muted" colspan="4">{t(lang, 'dashboard.common.loadingData')}</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Users Tab -->
      <div id="tab-users" class="tab-panel hidden dash-stack">
        <div class="dash-search-row">
          <label class="dash-field">
            <span>{t(lang, 'dashboard.common.searchByEmailOrName')}</span>
            <input
              type="text"
              placeholder={t(lang, 'dashboard.common.searchPlaceholder')}
              class="search-input dash-input"
            />
          </label>
          <button type="button" class="search-btn dash-btn">{t(lang, 'dashboard.common.search')}</button>
        </div>

        <div class="dash-table-wrap">
          <table class="dash-table">
            <thead>
              <tr>
                <th>{t(lang, 'dashboard.users.colEmail')}</th>
                <th>{t(lang, 'dashboard.users.colName')}</th>
                <th>{t(lang, 'dashboard.users.colRole')}</th>
                <th>{t(lang, 'dashboard.users.colLanguage')}</th>
                <th>{t(lang, 'dashboard.users.colCreated')}</th>
              </tr>
            </thead>
            <tbody class="users-table-body">
              <tr class="animate-pulse">
                <td class="dash-td-muted" colspan="5">{t(lang, 'dashboard.common.loadingData')}</td>
              </tr>
            </tbody>
          </table>
        </div>

        <div class="dash-status hidden"></div>
      </div>

      <!-- System Prompts Tab -->
      <div id="tab-prompts" class="tab-panel hidden dash-stack">
        <p class="dash-subtitle">
          {t(lang, 'dashboard.prompts.intro')}
        </p>

        <div class="dash-search-row">
          <label class="dash-field">
            <span>{t(lang, 'dashboard.common.searchByEmailOrName')}</span>
            <input
              type="text"
              placeholder={t(lang, 'dashboard.common.searchPlaceholder')}
              class="search-input dash-input"
            />
          </label>
          <button type="button" class="search-btn dash-btn">{t(lang, 'dashboard.common.search')}</button>
        </div>

        <div class="user-list dash-user-list"></div>

        <div class="prompt-editor dash-card dash-stack hidden">
          <div>
            <h3 class="dash-card-title">{t(lang, 'dashboard.prompts.editorTitle')}</h3>
            <div class="prompt-editor-user dash-subtitle"></div>
          </div>
          <textarea
            class="prompt-content dash-input dash-textarea"
            rows="10"
            placeholder={t(lang, 'dashboard.prompts.placeholder')}></textarea>
          <p class="dash-hint">
            {t(lang, 'dashboard.prompts.hint')}
          </p>
          <div class="dash-row dash-row--end">
            <button type="button" class="prompt-clear-btn dash-btn dash-btn--danger">{t(lang, 'dashboard.prompts.remove')}</button>
            <button type="button" class="prompt-save-btn dash-btn dash-btn--primary">{t(lang, 'dashboard.prompts.save')}</button>
          </div>
        </div>

        <div class="dash-status hidden"></div>
      </div>

      <!-- Memory Tab -->
      <div id="tab-memory" class="tab-panel hidden dash-stack">
        <section class="dash-stack">
          <h2 class="dash-section-title">{t(lang, 'dashboard.memory.pendingTitle')}</h2>
          <div class="memory-pending dash-stack">
            <div class="dash-td-muted animate-pulse">{t(lang, 'dashboard.common.loading')}</div>
          </div>
        </section>

        <section class="dash-stack">
          <h2 class="dash-section-title">{t(lang, 'dashboard.memory.approvedTitle')}</h2>
          <div class="memory-approved dash-stack">
            <div class="dash-td-muted animate-pulse">{t(lang, 'dashboard.common.loading')}</div>
          </div>
        </section>

        <div class="dash-status hidden"></div>
      </div>

      <!-- System Tab -->
      <div id="tab-uploads" class="tab-panel hidden dash-stack">
        <section class="dash-stack">
          <h2 class="dash-section-title">{t(lang, 'dashboard.uploads.title')}</h2>
          <div class="dash-table-wrap">
            <table class="dash-table">
              <thead>
                <tr>
                  <th class="dash-sortable" data-sort="filename">{t(lang, 'dashboard.uploads.colFilename')} <span class="dash-sort-caret"></span></th>
                  <th class="dash-sortable" data-sort="mime">{t(lang, 'dashboard.uploads.colType')} <span class="dash-sort-caret"></span></th>
                  <th class="dash-num dash-sortable" data-sort="size">{t(lang, 'dashboard.uploads.colSize')} <span class="dash-sort-caret"></span></th>
                  <th class="dash-sortable" data-sort="createdAt">{t(lang, 'dashboard.uploads.colUploaded')} <span class="dash-sort-caret"></span></th>
                  <th class="dash-sortable" data-sort="user">{t(lang, 'dashboard.uploads.colUser')} <span class="dash-sort-caret"></span></th>
                  <th>{t(lang, 'dashboard.uploads.colChat')}</th>
                  <th>{t(lang, 'dashboard.system.colActions')}</th>
                </tr>
              </thead>
              <tbody class="uploads-table-body">
                <tr class="animate-pulse">
                  <td class="dash-td-muted" colspan="7">{t(lang, 'dashboard.common.loadingData')}</td>
                </tr>
              </tbody>
            </table>
          </div>
        </section>
        <div class="dash-status hidden"></div>
      </div>

      <div id="tab-system" class="tab-panel hidden dash-stack">
        <div class="dash-search-row">
          <button type="button" class="system-refresh dash-btn">{t(lang, 'dashboard.system.refresh')}</button>
        </div>

        <section class="dash-stack">
          <h2 class="dash-section-title">{t(lang, 'dashboard.system.previewsTitle')}</h2>
          <div class="dash-table-wrap">
            <table class="dash-table">
              <thead>
                <tr>
                  <th>{t(lang, 'dashboard.system.colBranch')}</th>
                  <th>{t(lang, 'dashboard.system.colStatus')}</th>
                  <th>{t(lang, 'dashboard.system.colPortPid')}</th>
                  <th>{t(lang, 'dashboard.system.colStarted')}</th>
                  <th>{t(lang, 'dashboard.system.colLastUsed')}</th>
                  <th>{t(lang, 'dashboard.system.colActions')}</th>
                </tr>
              </thead>
              <tbody class="previews-table-body">
                <tr class="animate-pulse">
                  <td class="dash-td-muted" colspan="6">{t(lang, 'dashboard.common.loadingData')}</td>
                </tr>
              </tbody>
            </table>
          </div>
        </section>

        <section class="dash-stack">
          <h2 class="dash-section-title">{t(lang, 'dashboard.system.branchesTitle')}</h2>
          <div class="dash-table-wrap">
            <table class="dash-table">
              <thead>
                <tr>
                  <th>{t(lang, 'dashboard.system.colName')}</th>
                  <th>{t(lang, 'dashboard.system.colCreator')}</th>
                  <th class="dash-num">{t(lang, 'dashboard.system.colChats')}</th>
                  <th class="dash-num">{t(lang, 'dashboard.system.colPublications')}</th>
                  <th>{t(lang, 'dashboard.system.colState')}</th>
                  <th>{t(lang, 'dashboard.system.colCreated')}</th>
                  <th>{t(lang, 'dashboard.system.colActions')}</th>
                </tr>
              </thead>
              <tbody class="branches-table-body">
                <tr class="animate-pulse">
                  <td class="dash-td-muted" colspan="7">{t(lang, 'dashboard.common.loadingData')}</td>
                </tr>
              </tbody>
            </table>
          </div>
        </section>

        <section class="dash-stack">
          <h2 class="dash-section-title">{t(lang, 'dashboard.system.chatsTitle')}</h2>
          <div class="dash-table-wrap">
            <table class="dash-table">
              <thead>
                <tr>
                  <th>{t(lang, 'dashboard.system.colTitle')}</th>
                  <th>{t(lang, 'dashboard.system.colKind')}</th>
                  <th>{t(lang, 'dashboard.system.colPhase')}</th>
                  <th>{t(lang, 'dashboard.system.colBranches')}</th>
                  <th>{t(lang, 'dashboard.system.colCreator')}</th>
                  <th class="dash-num">{t(lang, 'dashboard.system.colMessages')}</th>
                  <th>{t(lang, 'dashboard.system.colCreated')}</th>
                  <th>{t(lang, 'dashboard.system.colActions')}</th>
                </tr>
              </thead>
              <tbody class="chats-table-body">
                <tr class="animate-pulse">
                  <td class="dash-td-muted" colspan="8">{t(lang, 'dashboard.common.loadingData')}</td>
                </tr>
              </tbody>
            </table>
          </div>
        </section>

        <div class="dash-status hidden"></div>
      </div>
    </div>

    <!-- Client Logic -->
    <script>
      import { initTabs } from '@/components/dashboard/tabs';
      initTabs();
    </script>
  </body>
</html>
