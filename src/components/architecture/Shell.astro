---
/**
 * Shared chrome for the whole /architecture tree: the diagram index and every
 * markdown guide. Markdown pages use it as their `layout`, so they arrive with
 * an `Astro.props.frontmatter` instead of explicit props.
 *
 * PUBLIC routes (see PUBLIC_PATHS in src/middleware.ts). Nothing here or in
 * the pages it wraps may read runtime state — no version or commit, no env
 * values, nothing that names this particular deployment.
 */
import { CHAPTERS } from './index';
import { GUIDES } from './guides';

interface Props {
  title?: string;
  /** Verbatim <title>; defaults to "<title> — CMS Agent". */
  docTitle?: string;
  /** Lead paragraph under the title. */
  lead?: string;
  /** Small print under the lead (HTML). */
  meta?: string;
  frontmatter?: { title?: string; lead?: string };
}

const { frontmatter } = Astro.props as Props;
// A guide arrives through the markdown `layout` hook; the index passes props.
const isGuide = Boolean(frontmatter);
const title = frontmatter?.title ?? Astro.props.title ?? 'Architecture';
const lead = frontmatter?.lead ?? Astro.props.lead ?? '';
const meta =
  Astro.props.meta ??
  '<a href="/architecture">back to the diagrams</a> · <a href="/">open the CMS</a>';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{Astro.props.docTitle ?? `${title} — CMS Agent`}</title>
    <meta name="description" content={lead || 'CMS Agent architecture reference.'} />
    <style is:global>
      :root {
        color-scheme: light dark;
        --bg: #ffffff;
        --bg-soft: #f4f6f8;
        --fg: #1a1d21;
        --fg-muted: #5b6472;
        --line: #dde2e8;
        --accent: #2f6feb;
        --code-bg: #eef1f5;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #0b0d10;
          --bg-soft: #12151a;
          --fg: #e6e8ea;
          --fg-muted: #98a2b0;
          --line: #2a2f36;
          --accent: #6ea0ff;
          --code-bg: #171b21;
        }
      }

      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--fg);
        font-family: system-ui, -apple-system, 'Segoe UI', sans-serif;
        line-height: 1.65;
      }
      a {
        color: var(--accent);
      }
      code {
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 0.9em;
        background: var(--code-bg);
        border-radius: 4px;
        padding: 0.1em 0.35em;
      }

      .page {
        max-width: 1680px;
        margin: 0 auto;
        padding: 2.5rem 1.5rem 6rem;
        display: grid;
        grid-template-columns: 15rem minmax(0, 1fr);
        gap: 2.5rem;
        align-items: start;
      }
      @media (max-width: 980px) {
        .page {
          grid-template-columns: minmax(0, 1fr);
          gap: 1.5rem;
        }
        .toc {
          position: static !important;
          max-height: none !important;
        }
      }

      /* ── Masthead ─────────────────────────────────────────────────────── */
      .masthead {
        grid-column: 1 / -1;
        border-bottom: 1px solid var(--line);
        padding-bottom: 1.5rem;
      }
      .masthead h1 {
        margin: 0 0 0.4rem;
        font-size: 2rem;
        letter-spacing: -0.02em;
      }
      .masthead p {
        margin: 0;
        color: var(--fg-muted);
        max-width: 60ch;
      }
      .masthead .meta {
        margin-top: 0.9rem;
        font-size: 0.85rem;
        color: var(--fg-muted);
      }

      /* ── Table of contents ────────────────────────────────────────────── */
      .toc {
        position: sticky;
        top: 2rem;
        max-height: calc(100vh - 4rem);
        overflow-y: auto;
        font-size: 0.9rem;
      }
      /* Closed: the list is gone, so give its column back to the prose. */
      body.toc-closed .page {
        grid-template-columns: minmax(0, 1fr);
      }
      body.toc-closed .toc {
        position: static;
        max-height: none;
      }
      .toc summary {
        cursor: pointer;
        list-style: none;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--fg-muted);
        padding: 0.35rem 0;
        user-select: none;
      }
      .toc summary::-webkit-details-marker {
        display: none;
      }
      .toc summary::before {
        content: '▾';
        display: inline-block;
        width: 1em;
        transition: transform 0.15s;
      }
      .toc:not([open]) summary::before {
        transform: rotate(-90deg);
      }
      .toc summary:hover {
        color: var(--fg);
      }
      .toc h2 {
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--fg-muted);
        margin: 1.4rem 0 0.5rem;
      }
      .toc h2:first-child {
        margin-top: 0;
      }
      .toc ol {
        list-style: none;
        margin: 0;
        padding: 0;
      }
      .toc a {
        display: block;
        padding: 0.25rem 0;
        text-decoration: none;
        color: var(--fg-muted);
        border-left: 2px solid transparent;
        padding-left: 0.7rem;
      }
      .toc a:hover {
        color: var(--fg);
        border-left-color: var(--accent);
      }
      .toc a[aria-current='page'] {
        color: var(--fg);
        border-left-color: var(--accent);
      }

      /* ── Diagram sections ─────────────────────────────────────────────── */
      section {
        scroll-margin-top: 1.5rem;
        margin-bottom: 4rem;
      }
      section h2 {
        font-size: 1.45rem;
        margin: 0 0 0.6rem;
        letter-spacing: -0.01em;
      }
      section h2 a.anchor {
        text-decoration: none;
        color: var(--fg-muted);
        opacity: 0;
        font-weight: 400;
        margin-left: 0.4rem;
      }
      section h2:hover a.anchor {
        opacity: 1;
      }
      .intro {
        color: var(--fg-muted);
        max-width: 72ch;
        margin: 0 0 1.5rem;
      }
      .notes ul {
        max-width: 78ch;
        padding-left: 1.2rem;
      }
      .notes li {
        margin-bottom: 0.55rem;
      }
      .notes table {
        border-collapse: collapse;
        margin: 1rem 0;
        font-size: 0.92rem;
        width: 100%;
      }
      .notes th,
      .notes td {
        border: 1px solid var(--line);
        padding: 0.45rem 0.7rem;
        text-align: left;
        vertical-align: top;
      }
      .notes th {
        background: var(--bg-soft);
      }

      /* ── Diagrams ─────────────────────────────────────────────────────── */
      .diagram {
        margin: 0 0 1.75rem;
      }
      .diagram figcaption {
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--fg-muted);
        margin-bottom: 0.4rem;
      }
      .canvas {
        border: 1px solid var(--line);
        border-radius: 10px;
        background: var(--bg-soft);
        padding: 1.25rem;
        overflow-x: auto;
      }
      /* Until mermaid has run, the source is the fallback — readable, and
         still there if the script never loads. */
      pre.mermaid {
        margin: 0;
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 0.8rem;
        color: var(--fg-muted);
        white-space: pre;
      }
      pre.mermaid[data-processed] {
        color: inherit;
      }
      /* Rendered at natural size and scrolled inside .canvas — fitting a wide
         diagram to the column shrinks its labels past readable. */
      pre.mermaid svg {
        height: auto;
      }

      .sources {
        font-size: 0.82rem;
        color: var(--fg-muted);
        border-top: 1px solid var(--line);
        padding-top: 0.6rem;
        margin-top: 1.5rem;
      }
      .sources code {
        background: none;
        padding: 0;
      }
      .sources code + code::before {
        content: ' · ';
        color: var(--line);
      }

      /* ── Markdown guides ──────────────────────────────────────────────── */
      .guide {
        max-width: 80ch;
      }
      .guide h2 {
        font-size: 1.35rem;
        margin: 2.5rem 0 0.6rem;
        letter-spacing: -0.01em;
      }
      .guide h3 {
        font-size: 1.05rem;
        margin: 1.8rem 0 0.4rem;
      }
      .guide table {
        border-collapse: collapse;
        margin: 1rem 0;
        font-size: 0.9rem;
        width: 100%;
        display: block;
        overflow-x: auto;
      }
      .guide th,
      .guide td {
        border: 1px solid var(--line);
        padding: 0.4rem 0.65rem;
        text-align: left;
        vertical-align: top;
      }
      .guide th {
        background: var(--bg-soft);
      }
      .guide pre {
        border: 1px solid var(--line);
        border-radius: 8px;
        padding: 0.9rem 1rem;
        overflow-x: auto;
        font-size: 0.85rem;
      }
      .guide :not(pre) > code {
        white-space: nowrap;
      }
      .guide blockquote {
        margin: 1rem 0;
        padding-left: 1rem;
        border-left: 3px solid var(--line);
        color: var(--fg-muted);
      }
      .guide input[type='checkbox'] {
        margin-right: 0.4rem;
      }
      .guide ul,
      .guide ol {
        padding-left: 1.3rem;
      }
      .guide li {
        margin-bottom: 0.35rem;
      }
    </style>
  </head>

  <body>
    <div class="page">
      <header class="masthead">
        <h1>{title}</h1>
        {lead && <p>{lead}</p>}
        <p class="meta" set:html={meta} />
      </header>

      <details class="toc" open>
        <summary aria-label="Toggle the contents">Contents</summary>
        <nav aria-label="Contents">
          {
            CHAPTERS.map((chapter) => (
              <>
                <h2>{chapter.title}</h2>
                <ol>
                  {chapter.sections.map((section) => (
                    <li>
                      <a href={`/architecture#${section.id}`}>{section.title}</a>
                    </li>
                  ))}
                </ol>
              </>
            ))
          }
          <h2>Guides</h2>
          <ol>
            {
              GUIDES.map((guide) => (
                <li>
                  <a
                    href={`/architecture/${guide.slug}`}
                    aria-current={isGuide && frontmatter?.title === guide.title ? 'page' : undefined}
                  >
                    {guide.title}
                  </a>
                </li>
              ))
            }
          </ol>
        </nav>
      </details>

      <main class={isGuide ? 'guide' : undefined}>
        <slot />
      </main>
    </div>

    <script is:inline>
      // The list is long; on a phone it buries the page. <details> already
      // collapses without any of this — the script only picks the starting
      // state, remembers the choice, and lets the prose reclaim the column.
      (() => {
        const toc = document.querySelector('details.toc');
        if (!toc) return;
        let stored = null;
        try {
          stored = localStorage.getItem('cmsagent-arch-toc');
        } catch {
          /* storage unavailable (private mode) — fall back to the viewport */
        }
        const sync = () => document.body.classList.toggle('toc-closed', !toc.open);
        toc.open = stored === null ? window.innerWidth > 980 : stored === '1';
        sync();
        toc.addEventListener('toggle', () => {
          sync();
          try {
            localStorage.setItem('cmsagent-arch-toc', toc.open ? '1' : '0');
          } catch {
            /* ignore */
          }
        });
      })();
    </script>
  </body>
</html>
