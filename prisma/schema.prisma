// cms-agent schema. Production provider is PostgreSQL; `pnpm test` derives a
// SQLite variant of this file (scripts/prepare-test-db.mjs), so keep it
// provider-portable: no Prisma enums (string columns with app-level unions),
// no Postgres-native types.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ─── better-auth core (shapes required by the prisma adapter) ────────────────

model User {
  id            String   @id
  name          String
  email         String
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // cms-agent additional fields
  role     String @default("editor") // 'admin' | 'editor'
  theme    String @default("system") // 'light' | 'dark' | 'system'
  language String @default("en")
  communicationMode String @default("default") // 'default' | 'technical' | 'non-technical'

  sessions               Session[]
  accounts               Account[]
  branches               Branch[]
  chats                  Chat[]
  messages               Message[]
  tokenUsage             TokenUsage[]
  uploads                Upload[]
  approvals              Approval[]
  approvedMemories       ApprovedMemory[]
  systemPromptExtensions SystemPromptExtension[]
  chatTabs               ChatTabs[]
  windowSessions         WindowSession[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ─── Branches & chats ────────────────────────────────────────────────────────

model Branch {
  id          String   @id @default(cuid())
  // DNS-safe label; doubles as git branch name and preview subdomain
  name        String   @unique
  // Null for branches synced from the git repo (incl. the default branch)
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  chats        Chat[]
  publications Publication[]

  @@map("branch")
}

model Chat {
  id          String @id @default(cuid())
  // Target branch the chat's work merges into (main or a long-lived branch)
  branchId    String
  branch      Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  // The chat's own git work branch (own worktree + preview subdomain),
  // based on the target branch and merged back into it on publish
  workBranch  String @unique
  // 'workflow' = normal plan/execute/preview/publish chat;
  // 'deployment' = per-publish chat hosting the deploy automatism;
  // 'deployments' = system chat over publication state (read-only tools)
  kind        String @default("workflow")
  title       String  @default("New chat")
  // Null for system chats (kind 'deployments')
  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id])

  // Workflow phase: 'plan' | 'execute' | 'published' (reviewing is part of execute)
  workflowPhase String @default("plan")
  // Turn phase: 'idle' | 'waiting_for_answer' | 'tool_pending'
  turnPhase       String  @default("idle")
  pendingQuestion Json?
  // Last failed turn's error — shown with a Retry button until cleared
  lastError       String?
  planJson        Json?
  // Explicit plan mode (the /plan command): the agent proposes a plan and
  // waits for approval instead of recording it and carrying on.
  planMode        Boolean @default(false)
  // Optimistic concurrency for phase transitions (no last-writer-wins)
  entityVersion   Int     @default(0)
  // Set when the chat is done (published / deployment finished): hidden from
  // the sidebar, listed in the archive view until deleted
  archivedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages         Message[]
  tokenUsage       TokenUsage[]
  executions       Execution[]
  approvals        Approval[]
  memoryCandidates MemoryCandidate[]
  publications     Publication[]
  tabs             ChatTabs[]
  tasks            ChatTask[]
  automatisms      Automatism[]
  uploads          Upload[]

  @@index([branchId])
  @@map("chat")
}

// ─── Automatisms ─────────────────────────────────────────────────────────────

// An agent-less flow attached to a chat (e.g. the deploy pipeline). Steps run
// server-side and post role:'automatism' messages into the chat; on a step
// failure the automatism pauses and the agent is invoked with that context.
// resume_automatism retries the failed step and continues.
model Automatism {
  id     String @id @default(cuid())
  chatId String
  chat   Chat   @relation(fields: [chatId], references: [id], onDelete: Cascade)
  // Registered automatism type, e.g. 'deploy'
  type   String
  // 'running' | 'paused' | 'done' | 'failed'
  status String @default("running")
  // Index of the current/failed step
  step   Int    @default(0)
  // Type-specific payload (shas, branch names, publication id, actor, …)
  data   Json
  // Chat the agent was invoked in on the last failure (resume lookup)
  agentChatId String?
  lastError   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([chatId])
  @@index([agentChatId])
  @@map("automatism")
}

// Soft window session: per-window view-state blob (which chat, diff mode,
// compare mode, open code file, …). The client mirrors its view state here
// debounced; fresh windows are OFFERED the saved sessions on load. Clicks
// never round-trip — this is passive continuity storage, not live state.
model WindowSession {
  id        String   @id // client-generated window UUID
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String   @default("")
  state     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, updatedAt])
  @@map("window_session")
}

// A chat's task list: what the agent committed to doing, in order. Written
// by the agent while planning and executing; the display text is shown to the
// user, the note is the agent's own working memory.
model ChatTask {
  id     String @id @default(cuid())
  chatId String
  chat   Chat   @relation(fields: [chatId], references: [id], onDelete: Cascade)
  // What the user sees in the chat's task list
  text   String
  // Agent-only working note (implementation detail, file, gotcha) — never shown
  note   String?
  // 'todo' | 'working' | 'done'
  status String @default("todo")
  // Manual ordering; ties break by createdAt
  order  Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([chatId])
  @@map("chat_task")
}

// Per-user open preview tabs of a chat (synced across sessions via SSE)
model ChatTabs {
  id          String   @id @default(cuid())
  chatId      String
  chat        Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Array of routes, e.g. ["/", "/blog/"]
  tabs        Json
  activeIndex Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@unique([chatId, userId])
  @@map("chat_tabs")
}

model Message {
  id       String  @id @default(cuid())
  chatId   String
  chat     Chat    @relation(fields: [chatId], references: [id], onDelete: Cascade)
  // Null for assistant/tool messages
  authorId String?
  author   User?   @relation(fields: [authorId], references: [id])

  // 'user' | 'assistant' | 'cancel' | 'tool' | 'automatism'
  role          String
  content       String @default("")
  // Command the message was sent with (see lib/commands) — rendered as a chip
  contentBlocks Json?
  command       String?
  pageContext   Json?
  ordinal       Int

  createdAt DateTime @default(now())

  attachments Upload[]

  @@unique([chatId, ordinal])
  @@index([chatId])
  @@map("message")
}

model TokenUsage {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  chatId       String?
  chat         Chat?    @relation(fields: [chatId], references: [id], onDelete: SetNull)
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
  @@map("token_usage")
}

// ─── Executions and approvals ────────────────────────────────────────────────

model Execution {
  id            String   @id @default(cuid())
  chatId        String
  chat          Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sha           String
  summary       String
  revertedBySha String?
  createdAt     DateTime @default(now())

  @@index([chatId])
  @@map("execution")
}

model Approval {
  id             String   @id @default(cuid())
  chatId         String
  chat           Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  actorId        String
  actor          User     @relation(fields: [actorId], references: [id])
  // 'plan' | 'publish'
  action         String
  planHash       String?
  baseSha        String
  targetSha      String?
  idempotencyKey String   @unique
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  @@index([chatId, action])
  @@map("approval")
}

// ─── Memory ──────────────────────────────────────────────────────────────────

model MemoryCandidate {
  id        String   @id @default(cuid())
  chatId    String
  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  content   String
  source    String
  reason    String
  // 'pending' | 'approved' | 'rejected'
  status    String   @default("pending")
  createdAt DateTime @default(now())

  approvedMemory ApprovedMemory?

  @@map("memory_candidate")
}

model ApprovedMemory {
  id           String          @id @default(cuid())
  candidateId  String          @unique
  candidate    MemoryCandidate @relation(fields: [candidateId], references: [id])
  content      String
  approvedById String
  approvedBy   User            @relation(fields: [approvedById], references: [id])
  revokedAt    DateTime?
  createdAt    DateTime        @default(now())

  @@map("approved_memory")
}

// ─── Uploads, publications, artifacts ────────────────────────────────────────

model Upload {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Chat this upload is attached to (null for global editorial uploads).
  chatId     String?
  chat       Chat?    @relation(fields: [chatId], references: [id], onDelete: Cascade)
  // Message the upload was sent with (set when the user turn is persisted).
  messageId  String?
  message    Message? @relation(fields: [messageId], references: [id], onDelete: SetNull)
  filename   String
  storedPath String
  mime       String
  size       Int
  sha256     String
  createdAt  DateTime @default(now())

  @@index([chatId])
  @@index([messageId])
  @@map("upload")
}

model Publication {
  id          String   @id @default(cuid())
  chatId      String
  chat        Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  branchId    String
  branch      Branch   @relation(fields: [branchId], references: [id])
  sha         String
  flow        String
  // 'running' | 'succeeded' | 'failed' | 'external_unknown'
  status      String   @default("running")
  log         String   @default("")
  externalUrl String?
  createdAt   DateTime @default(now())

  artifacts Artifact[]

  @@index([branchId])
  @@map("publication")
}

model Artifact {
  id            String      @id @default(cuid())
  publicationId String
  publication   Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  sha           String
  tarballPath   String
  manifest      Json
  buildMeta     Json
  createdAt     DateTime    @default(now())

  @@index([sha])
  @@map("artifact")
}

// ─── Admin ───────────────────────────────────────────────────────────────────

model SystemPromptExtension {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("system_prompt_extension")
}

// Global app-wide settings keyed by a stable string (e.g. admin toggles).
model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("app_setting")
}
