{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsx": "preserve",
    "jsxImportSource": "astro",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    ".astro/types.d.ts",
    "src",
    "test",
    "scripts"
  ],
  "exclude": [
    "dist",
    "chat",
    "examples",
    "proxy",
    "plugins"
  ]
}
