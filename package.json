{
  "name": "cms-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Chat-agent CMS for Astro sites — branch previews, plan/execute/preview/publish workflow",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:architecture": "astro build --config astro.config.architecture.mjs",
    "start": "node server.mjs",
    "preview": "astro preview",
    "test": "node scripts/prepare-test-db.mjs && vitest run --no-file-parallelism --exclude 'test/integration/**' --exclude 'test/sandbox.test.ts'",
    "test:sandbox": "bash scripts/launch-with-sandbox.sh vitest run test/sandbox.test.ts",
    "test:integration": "node scripts/prepare-test-db.mjs && bash scripts/launch-with-sandbox.sh vitest run test/integration",
    "bench": "node testbench/launcher.mjs",
    "bench:api": "node testbench/launcher.mjs --group api",
    "bench:ui": "node testbench/launcher.mjs --group ui",
    "bench:e2e": "node testbench/launcher.mjs --group e2e",
    "bench:admin": "node testbench/launcher.mjs --group admin",
    "bench:proxy": "node testbench/launcher.mjs --group proxy",
    "bench:recovery": "node testbench/launcher.mjs --group recovery",
    "bench:auth": "node testbench/launcher.mjs --group auth",
    "db:start": "node scripts/local-postgres.mjs start",
    "db:stop": "node scripts/local-postgres.mjs stop",
    "db:status": "node scripts/local-postgres.mjs status",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@astrojs/node": "^10.0.4",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-prometheus": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-metrics": "^2.10.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@tailwindcss/vite": "^4.1.11",
    "apexcharts": "^5.3.6",
    "astro": "^6.1.3",
    "better-auth": "^1.2.8",
    "dotenv": "^17.3.1",
    "jq-wasm": "3.0.0-jq-1.8.2",
    "marked": "^17.0.5",
    "mcporter": "^0.12.3",
    "mermaid": "^11.16.0",
    "octokit": "^4.1.0",
    "openai": "^4.100.0",
    "pixelmatch": "^7.1.0",
    "pngjs": "^7.0.0",
    "shiki": "^4.3.1",
    "simple-git": "^3.27.0",
    "tailwindcss": "^4.1.17",
    "tar": "^7.4.3",
    "yaml": "^2.9.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@types/node": "^22.20.1",
    "@types/pngjs": "^6.0.5",
    "astro-compress": "^2.3.8",
    "esbuild": "^0.27.7",
    "oauth2-mock-server": "^9.1.0",
    "playwright": "1.60.0",
    "prisma": "^7.8.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.2"
  }
}
