{
  "name": "cms-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Chat-agent CMS for Astro sites — branch previews, plan/execute/preview/publish workflow",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "start": "node server.mjs",
    "preview": "astro preview",
    "test": "node scripts/prepare-test-db.mjs && vitest run --exclude 'test/integration/**' --exclude 'test/sandbox.test.ts'",
    "test:sandbox": "bash scripts/launch-with-sandbox.sh vitest run test/sandbox.test.ts",
    "test:integration": "node scripts/prepare-test-db.mjs && bash scripts/launch-with-sandbox.sh vitest run test/integration",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@astrojs/node": "^10.0.4",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@tailwindcss/vite": "^4.1.11",
    "apexcharts": "^5.3.6",
    "astro": "^6.1.3",
    "better-auth": "^1.2.8",
    "dotenv": "^17.3.1",
    "marked": "^17.0.5",
    "mcporter": "^0.12.3",
    "octokit": "^4.1.0",
    "openai": "^4.100.0",
    "pixelmatch": "^7.1.0",
    "pngjs": "^7.0.0",
    "shiki": "^4.3.1",
    "simple-git": "^3.27.0",
    "tailwindcss": "^4.1.17",
    "tar": "^7.4.3",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@types/node": "^22.20.1",
    "@types/pngjs": "^6.0.5",
    "astro-compress": "^2.3.8",
    "esbuild": "^0.27.7",
    "playwright": "1.60.0",
    "prisma": "^7.8.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.2"
  }
}
